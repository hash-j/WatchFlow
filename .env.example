# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=
TMDB_READ_ACCESS_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public browser Push API application-server key. Never place a VAPID private key
# in a NEXT_PUBLIC variable; delivery/signing is outside Part 18E.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only VAPID signing configuration used by the request-driven dispatcher.
# Generate this as a pair with NEXT_PUBLIC_VAPID_PUBLIC_KEY. Never expose it in
# a NEXT_PUBLIC variable or browser bundle.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
# Strong server-only bearer secret for manually invoking the Part 18I internal
# scheduled-reminder executor. Keep separate from Supabase and VAPID secrets.
WATCHFLOW_SCHEDULER_SECRET=

# Playwright QA names only. Keep real values in an ignored local environment file.
E2E_BASE_URL=
E2E_WEB_SERVER_COMMAND=
PLAYWRIGHT_BASE_URL=
E2E_TARGET_ENV=
E2E_EXPECTED_SUPABASE_URL=
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
E2E_DELETE_ACCOUNT_EMAIL=
E2E_DELETE_ACCOUNT_PASSWORD=
E2E_RUN_ACCOUNT_DELETION=
E2E_TEST_MOVIE_QUERY=
E2E_ONBOARDING_MOVIE_QUERY_A=
E2E_ONBOARDING_MOVIE_QUERY_B=
RUN_SUPABASE_INTEGRATION_TESTS=
RUN_ONBOARDING_INTEGRATION_TESTS=
RUN_TMDB_RATE_LIMIT_INTEGRATION_TESTS=
E2E_RATE_LIMIT_BUCKETS_ARE_FRESH=
RUN_TMDB_RATE_LIMIT_E2E=
E2E_RATE_LIMIT_UI_BUCKETS_ARE_FRESH=


E2E_TARGET_ENV=
E2E_EXPECTED_SUPABASE_URL=

E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=

E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
